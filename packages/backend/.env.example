# Copy to .env and fill in. The server boots without DATABASE_URL (health
# reports db: "unconfigured"), but data routes require it.

# Postgres the server explores. This default matches demo/docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/pagila

# Schema to introspect and query (Phase C+).
PG_SCHEMA=public

# Server bind address.
HOST=127.0.0.1
PORT=5174

# Hard cap on rows any single query may return.
ROW_LIMIT=500

# Browser origin allowed via CORS (the Vite dev server).
CORS_ORIGIN=http://localhost:5173
